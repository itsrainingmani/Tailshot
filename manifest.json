{
	"manifest_version": 3,
	"name": "Tailshot",
	"short_name": "Tailshot",
	"version": "1.0",
	"description": "Send images to your Tailscale devices",
	"homepage_url": "https://github.com/itsrainingmani/Tailshot",
	"permissions": ["contextMenus", "nativeMessaging"],
	"optional_host_permissions": ["http://*/*", "https://*/*"],
	"background": {
		"scripts": ["background.js"],
		"service_worker": "background.js"
	},
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"browser_specific_settings": {
		"gecko": {
			"id": "tailshot@bitandbang.com"
		}
	}
}
